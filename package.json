{
  "name": "nestmark",
  "version": "0.4.0",
  "private": true,
  "description": "A trustworthy bookmark-inbox sorter for Chromium browsers.",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.build.json && node scripts/copy-static.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run validate:build",
    "clean": "node scripts/clean.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:build": "node scripts/validate-build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "eslint": "^10.11.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
